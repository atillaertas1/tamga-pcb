{
  "$schema": "https://anthropic.com/claude-code/plugin.schema.json",
  "name": "tamga-pcb",
  "version": "0.1.0",
  "description": "Token-efficient KiCad PCB design: schematic from a JSON spec, placement, autorouting, DRC/ERC and JLCPCB fab export.",
  "author": {
    "name": "Atilla"
  },
  "homepage": "https://github.com/atillaertas1/tamga-pcb",
  "repository": "https://github.com/atillaertas1/tamga-pcb",
  "license": "MIT",
  "keywords": [
    "kicad",
    "pcb",
    "electronics",
    "jlcpcb",
    "mcp"
  ],
  "skills": [
    "./skills/"
  ],
  "mcpServers": {
    "tamga": {
      "command": "uv",
      "args": [
        "run",
        "--quiet",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "--extra",
        "lcsc",
        "tamga"
      ]
    }
  }
}
